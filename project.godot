; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="xiantu"
run/main_scene="res://ui/main/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

AppLog="*res://autoload/app_log.gd"
GameManager="*res://autoload/game_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="xiantu"

[editor_plugins]

enabled=PackedStringArray("res://addons/exploration_map/plugin.cfg", "res://addons/npc_editor/plugin.cfg")

[gui]

theme/custom="res://ui/theme/game_theme.tres"
theme/custom_font="res://assets/fonts/source_han_sans_cn/SourceHanSansCN-Regular.otf"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
