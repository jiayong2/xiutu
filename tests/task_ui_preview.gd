extends SceneTree
var failures:=0
var checks:=0
var main: Control
var manager: Node
func _initialize() -> void:call_deferred("run")
func check(ok: bool,title: String) -> void:
	checks+=1
	if not ok:failures+=1;push_error(title)
	print("%s %s" % ["PASS" if ok else "FAIL",title])
func settle() -> void:
	for i in range(5):await process_frame
	if DisplayServer.get_name() != "headless":
		await RenderingServer.frame_post_draw
func view() -> Control:return main.content.get_node("TaskPage")
func screenshot(name: String) -> void:
	if DisplayServer.get_name() != "headless":
		check(root.get_texture().get_image().save_png("res://docs/screenshots/"+name+".png")==OK,"screenshot: "+name)
func run() -> void:
	manager=root.get_node("GameManager")
	manager.new_game("无名散修","金")
	var static_home: Control=load("res://ui/main/home_view.tscn").instantiate()
	check(static_home.find_child("CultivationCard",true,false)!=null,"home layout exists before running scripts")
	static_home.field("Layout").add_theme_constant_override("margin_left",48)
	static_home.build(manager.operations.snapshot(),manager.catalog.tables,"")
	check(static_home.field("Layout").get_theme_constant("margin_left")==48,"live binding preserves editor layout adjustments")
	static_home.free()
	var static_task: Control=load("res://ui/quest/task_page.tscn").instantiate()
	check(static_task.field("TaskList").get_child_count()==3,"task template includes offline list preview")
	check(not static_task.field("Description").text.is_empty(),"task template includes offline detail preview")
	static_task.free()
	root.size=Vector2i(1920,1080)
	main=load("res://ui/main/main.tscn").instantiate();main.page="任务";root.add_child(main)
	await settle()
	var page:=view()
	check(page.field("TaskTitle").get_parsed_text()=="暂无任务","new game has no accepted task details")
	check(page.field("TaskList").get_child_count()==0,"unaccepted quests are hidden")
	var left: Control=page.field("TaskListPanel")
	var right: Control=page.field("TaskDetailPanel")
	check(absf(left.size.x/(left.size.x+right.size.x)-0.32)<0.01,"32/68 panels")
	check(left.get_global_rect().end.x<right.get_global_rect().position.x,"no panel overlap")
	check(page.field("Primary").disabled and not page.field("Talk").visible,"empty task list has no available actions")
	var before: Dictionary=manager.operations.snapshot()
	page._select("quest_qinglan_003")
	check(page.selected_id.is_empty() and not page.field("DetailScroll").visible,"locked task cannot expose its details")
	page._filter("进行中")
	check(page.selected_id.is_empty() and page.field("Primary").disabled,"empty filter state")
	check(manager.operations.snapshot()==before,"filter and selection do not mutate state")
	page._filter("全部");manager.request("accept_announcement",{"id":"notice_qinglan_001"})
	await settle();page=view()
	check(manager.operations.snapshot().quests.quest_qinglan_001.status=="ACTIVE","accept routes through existing service")
	check(page.field("Primary").text=="进行中" and page.field("Primary").disabled,"active objective not ready")
	check(page.field("TaskType").get_line_count()==1,"task type stays horizontal")
	check(page.field("Rewards").get_parsed_text().contains("灵石 ×30") and page.field("Rewards").get_parsed_text().contains("凝血散"),"real rewards displayed")
	check(page.field("Rewards").text.contains("[color=#B77724]×30[/color]"),"reward quantity is warm gold")
	check(page.field("Objective").text.contains("[color=#287F9C]0/1[/color]") and page.field("Objective").text.contains("[color=#899B95]0/1[/color]"),"active and inactive progress are distinct")
	check(page.field("Objective").text.contains("[color=#B77724]1份凝血散[/color]"),"objective item quantity is warm gold")
	screenshot("task_1920x1080")
	check(page.field("Talk").visible and not page.field("Talk").disabled,"quest dialogue inside details")
	var current_hint: String=manager.operations.quests.current(manager.operations.snapshot(),"quest_qinglan_001",manager.catalog.tables).hint
	check(page.field("ActionReason").text==current_hint,"task detail uses actual current objective hint")
	page.field("Track").pressed.emit();await settle()
	main._navigate("主界面");await settle()
	var home: Control=main.content.get_node("HomeView")
	check(home.field("TaskHint").text==current_hint,"home tracking matches task stage")
	main._navigate("任务");await settle();page=view()
	manager.request("npc_option",{"npc":"npc_qin_shoushan","option":"ask_qinglan_disturbance"})
	manager.request("travel",{"id":"area_qinglan_outskirts"})
	manager.request("investigate",{"id":"event_beast_tracks","option":"inspect_tracks"})
	manager.request("travel",{"id":"town_qinglan"})
	await settle();page=view()
	check(page.field("Primary").text=="向发布者交付" and not page.field("Primary").disabled,"ready to claim")
	screenshot("task_ready_1920x1080")
	manager.request("npc_option",{"npc":"npc_qin_shoushan","option":"report_quest_qinglan_001"});await settle();page=view()
	check(page.field("Primary").text=="已完成" and page.field("Primary").disabled,"completed cannot repeat")
	check(page.field("Objective").text.contains("[color=#39834D]1/1[/color]"),"completed progress is green")
	check(manager.operations.snapshot().player.spirit_stones==150,"real reward settled")
	page._filter("已完成")
	check(page.visible_ids()==["quest_qinglan_001"],"completed filter")
	page._filter("全部")
	check(page.visible_ids()==["quest_qinglan_001"],"unlocked follow-up stays hidden until accepted")
	manager.request("accept",{"id":"quest_qinglan_002"})
	var payload: Dictionary=manager.operations.export_save()
	payload.state.quests.quest_qinglan_002.objectives.kill_gray_wolf.current_count=1
	payload.state.quests.quest_qinglan_002.objectives.kill_gray_wolf.status="COMPLETED"
	manager.operations.restore_save(payload)
	await settle();page=view();page._filter("全部");page._select("quest_qinglan_002")
	check(page.field("Primary").disabled and page.field("ActionReason").text.contains("灰狼牙"),"missing submission material prevents claim")
	var saves:=preload("res://core/save_service.gd").new()
	var path:=saves.write(manager.operations.export_save(),"user://test_saves")
	check(not path.is_empty() and manager.operations.restore_save(saves.read(path)).is_empty(),"task save state remains loadable")
	await settle();page=view()
	# Stress fixtures remain view-only and never enter the game catalog or saves.
	var tables: Dictionary=manager.catalog.tables.duplicate(true)
	before=manager.operations.snapshot()
	var fixture: Dictionary=before.duplicate(true)
	for i in range(100):
		var q: Dictionary=tables.quests.quest_qinglan_001.duplicate(true)
		q.id="test_quest_%03d" % i;q.name="测试专用任务%03d" % i;tables.quests[q.id]=q
		fixture.quests[q.id]=manager.operations.quests.instance(q)
	tables.quests.quest_qinglan_001.description="长描述滚动测试。".repeat(300)
	page.bind_data(fixture,tables,"quest_qinglan_001","全部")
	await settle()
	check(page.field("TaskList").get_child_count()==102,"large list stays scrollable")
	check(page.field("ListScroll").get_v_scroll_bar().max_value>page.field("ListScroll").size.y,"list scrollbar")
	check(page.field("DetailScroll").get_v_scroll_bar().max_value>page.field("DetailScroll").size.y,"long detail scrollbar")
	check(page.field("ActionBar").get_global_rect().end.y<1080-32,"actions remain visible")
	check(manager.operations.snapshot()==before,"stress fixture isolated")
	screenshot("task_stress_1920x1080")
	page.bind_data(before,manager.catalog.tables,"quest_qinglan_002","全部")
	root.size=Vector2i(1280,720);await settle();screenshot("task_1280x720")
	check(page.get_global_rect().encloses(page.field("ActionBar").get_global_rect()),"action bar fits at 1280x720")
	page.field("Back").pressed.emit();await settle()
	check(main.page=="主界面","back navigation")
	print("TASK UI: %d checks, %d failures" % [checks,failures])
	quit(0 if failures==0 else 1)
